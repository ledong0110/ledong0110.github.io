---
layout: default
---
<div class="post academic-home">
  <section class="academic-intro" aria-labelledby="name-heading">
    <div class="academic-intro-text">
      <h1 id="name-heading">Dong Le</h1>
      {{ content }}
      <nav class="academic-links" aria-label="Contact and profiles">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <a href="https://www.linkedin.com/in/donglecs/">LinkedIn</a>
        <a href="{{ '/assets/pdf/CV.pdf' | relative_url }}">CV</a>
      </nav>
    </div>
    <img class="academic-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Dong Le" width="112" height="140" fetchpriority="high">
  </section>
  {% if page.announcements.enabled %}
    <section class="academic-section" aria-labelledby="news-heading">
      <h2 id="news-heading">News</h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}
  {% if page.selected_papers %}
    <section class="academic-section" aria-labelledby="papers-heading">
      <h2 id="papers-heading">Selected publications</h2>
      {% include selected_papers.liquid %}
      <p><a href="{{ '/publications/' | relative_url }}">Full publication list</a></p>
    </section>
  {% endif %}
</div>
