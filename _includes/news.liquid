<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | sort: 'date' | reverse %}
    {% assign news_limit = news | size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% endif %}
    <ul class="news-list">
      {% for item in news limit: news_limit %}
        <li class="news-item">
          <time class="news-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
          <div class="news-update">
            <span class="news-icon" aria-hidden="true">{{ item.icon | default: '📝' }}</span>
            <div class="news-copy">
              {% if item.inline %}
                {{ item.content | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
